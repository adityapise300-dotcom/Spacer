<% layout('/layouts/boilerplate') -%>
<a href="/owner/zones" class="small text-decoration-none">&larr; My zones</a>
<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mt-1 mb-3">
  <div>
    <h1 class="h3 mb-1"><%= zone.name %> <% if (!zone.isActive) { %><span class="badge text-bg-secondary fs-6">Hidden</span><% } %></h1>
    <div class="text-muted small"><i class="bi bi-geo-alt"></i> <%= zone.address %>, <%= zone.city %> · <%= zone.openTime %> to <%= zone.closeTime %> · base <%= fmt.currency(zone.basePricePerHour) %>/h</div>
  </div>
  <div class="d-flex gap-2">
    <a class="btn btn-outline-primary btn-sm" href="/owner/insights?zone=<%= zone._id %>"><i class="bi bi-graph-up"></i> Insights</a>
    <a class="btn btn-outline-primary btn-sm" href="/owner/zones/<%= zone._id %>/edit"><i class="bi bi-pencil"></i> Edit</a>
    <form action="/owner/zones/<%= zone._id %>?_method=DELETE" method="POST" data-confirm="Delete this zone? Its slots, booking history and revenue records will be removed too.">
      <button class="btn btn-outline-danger btn-sm" type="submit"><i class="bi bi-trash"></i> Delete</button>
    </form>
  </div>
</div>
<p class="small">
  <% zone.vehicleTypesAllowed.forEach(function (t) { %><span class="badge text-bg-light border"><i class="bi <%= fmt.vehicleIcon(t) %>"></i> <%= fmt.vehicleLabel(t) %></span> <% }) %>
  <% (zone.amenities || []).forEach(function (a) { %><span class="badge text-bg-secondary"><%= a %></span> <% }) %>
</p>

<div class="row g-4">
  <div class="col-lg-8"><%- include('../slots/manage', { zone: zone, slots: slots }) %></div>
  <div class="col-lg-4">
    <h5>Upcoming bookings</h5>
    <% if (!upcoming.length) { %><p class="text-muted small">None yet.</p><% } else { upcoming.forEach(function (b) { %>
      <div class="card mb-2"><div class="card-body py-2 small">
        <strong><%= b.slotLabel %></strong> · <%= b.user ? b.user.name : 'Driver' %><br>
        <span class="text-muted"><%= fmt.dateTime(b.startTime) %> to <%= fmt.timeOnly(b.endTime) %></span>
      </div></div>
    <% }) } %>
  </div>
</div>
