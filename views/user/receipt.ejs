<% layout('/layouts/boilerplate') -%>
<div class="row justify-content-center"><div class="col-lg-7">
  <div class="d-flex justify-content-between mb-2 no-print">
    <a href="/user/bookings/<%= booking._id %>" class="small text-decoration-none">&larr; Booking details</a>
    <button class="btn btn-sm btn-outline-primary" type="button" data-print><i class="bi bi-printer"></i> Print receipt</button>
  </div>
  <div class="card"><div class="card-body p-4">
    <div class="d-flex justify-content-between align-items-start">
      <div><h1 class="h4 mb-0"><img src="/images/logo.png" class="sp-logo-img" alt="SPACER logo" width="32" height="32">SPACER</h1><div class="small text-muted">Payment receipt</div></div>
      <div class="text-end small text-muted">Booking <code><%= String(booking._id).slice(-8).toUpperCase() %></code></div>
    </div>
    <hr>
    <dl class="row mb-0">
      <dt class="col-sm-4">Parking zone</dt><dd class="col-sm-8"><%= booking.zone.name %><div class="small text-muted"><%= booking.zone.address %></div></dd>
      <dt class="col-sm-4">Slot</dt><dd class="col-sm-8"><%= booking.slotLabel %></dd>
      <dt class="col-sm-4">Vehicle</dt><dd class="col-sm-8"><%= booking.vehiclePlate %> (<%= fmt.vehicleLabel(booking.vehicleType) %>)</dd>
      <dt class="col-sm-4">From</dt><dd class="col-sm-8"><%= fmt.dateTime(booking.startTime) %></dd>
      <dt class="col-sm-4">Until</dt><dd class="col-sm-8"><%= fmt.dateTime(booking.endTime) %></dd>
      <dt class="col-sm-4">Status</dt><dd class="col-sm-8"><%= fmt.statusLabel(booking.status) %></dd>
    </dl>
    <hr>
    <table class="table table-sm mb-0">
      <thead><tr><th>Reference</th><th>Type</th><th>Method</th><th>Date</th><th class="text-end">Amount</th></tr></thead>
      <tbody>
        <% transactions.forEach(function (t) { %>
          <tr>
            <td><code><%= t.referenceId %></code></td>
            <td><%= t.status === 'refunded' ? 'Refund' : 'Payment' %></td>
            <td class="text-uppercase"><%= t.method %></td>
            <td><%= fmt.dateTime(t.paidAt) %></td>
            <td class="text-end <%= t.status === 'refunded' ? 'text-danger' : '' %>"><%= t.status === 'refunded' ? '−' : '' %><%= fmt.currency(t.amount) %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    <p class="small text-muted mt-3 mb-0">Demo receipt from a mock payment gateway.</p>
  </div></div>
</div></div>
