<% layout('/layouts/boilerplate') -%>
<%# The layout has no per-page <head> slot, so the dashboard assets are linked here (these two views only). %>
<link rel="stylesheet" href="/css/dashboard.css">
<script src="/js/dashboard.js" defer></script>
<%# Leaflet + OpenStreetMap: free, no API key. jsDelivr is already allowed by the CSP. Deferred scripts run in order. %>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css">
<script src="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js" defer></script>
<script src="/js/dashboard-map.js" defer></script>

<div class="db-page">

  <%# 1. Welcome banner + quick search (same field names and action as before) %>
  <header class="db-hero">
    <h1 class="db-hero__title">Hello, <%= currentUser.name.split(' ')[0] %></h1>
    <p class="db-hero__tag">Find a bay, book it in minutes and park without circling the block.</p>
  </header>
  <section class="db-search" aria-labelledby="db-search-title">
    <h2 class="visually-hidden" id="db-search-title">Quick search</h2>
    <form action="/user/search" method="GET" class="row g-2 align-items-end">
      <div class="col-12 col-md-3"><label class="form-label small mb-1" for="q">Area or name</label><input class="form-control" id="q" name="q" placeholder="Koregaon Park"></div>
      <div class="col-12 col-sm-6 col-md-3"><label class="form-label small mb-1" for="start">From</label><input type="datetime-local" step="900" class="form-control" id="start" name="start" value="<%= defaults.start %>"></div>
      <div class="col-12 col-sm-6 col-md-3"><label class="form-label small mb-1" for="end">Until</label><input type="datetime-local" step="900" class="form-control" id="end" name="end" value="<%= defaults.end %>"></div>
      <div class="col-8 col-md-2"><label class="form-label small mb-1" for="vehicleType">Vehicle</label>
        <select class="form-select" id="vehicleType" name="vehicleType"><option value="">Any</option>
          <% ['bike','car','suv','ev'].forEach(function (t) { %><option value="<%= t %>"><%= fmt.vehicleLabel(t) %></option><% }) %>
        </select></div>
      <div class="col-4 col-md-1"><button class="btn btn-primary w-100" type="submit" aria-label="Search parking"><i class="bi bi-search" aria-hidden="true"></i></button></div>
    </form>
  </section>

  <%# 2. Parking near you: Google map with zone pins (replaces the big "next booking" card).
        The next booking is kept as a compact strip at the bottom of the same card so "Pay now" is never lost. %>
  <section class="db-section" aria-labelledby="db-map-title">
    <div class="db-head">
      <div>
        <h2 class="db-section__title mb-1" id="db-map-title">Parking near you</h2>
        <p class="db-muted mb-0" data-map-status role="status" aria-live="polite">Allow location to see parking zones around you.</p>
      </div>
      <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3" data-map-locate hidden><i class="bi bi-crosshair" aria-hidden="true"></i> Use my location</button>
    </div>

    <div class="db-card db-map" data-db-map>
      <%# Plain JSON data block: not executed, so it is allowed by the CSP. "<" is escaped so a zone name can never close the tag. %>
      <script type="application/json" data-map-zones><%- JSON.stringify(mapZones).replace(/</g, '\\u003c') %></script>

      <div class="db-map__stage">
        <div class="db-map__canvas" data-map-canvas role="region" aria-label="Map of parking zones near you"></div>
        <div class="db-map__fallback" data-map-fallback hidden>
          <i class="bi bi-map" aria-hidden="true"></i>
          <strong data-map-fallback-title>Map unavailable</strong>
          <span data-map-fallback-text>The map could not be loaded.</span>
          <a class="btn btn-primary btn-sm rounded-pill px-3" href="/user/search">Search parking instead</a>
        </div>
      </div>

      <ul class="db-map__legend" aria-label="Map legend">
        <li><span class="db-key db-key--ok"></span> Bays free</li>
        <li><span class="db-key db-key--low"></span> Few left</li>
        <li><span class="db-key db-key--full"></span> Full</li>
        <li><span class="db-key db-key--none"></span> Closed / no bays</li>
        <li><span class="db-key db-key--booked"></span> Your booking</li>
        <li><span class="db-key db-key--me"></span> You</li>
      </ul>

      <% if (nextBooking) { const b = nextBooking; const z = b.zone; %>
        <div class="db-map__booking">
          <div class="db-map__booking-main">
            <span class="db-countdown db-countdown--<%= b.countdown.tone %>"><i class="bi bi-hourglass-split" aria-hidden="true"></i> <%= b.countdown.text %></span>
            <strong class="db-map__booking-title"><%= z ? z.name : 'Parking zone' %></strong>
            <span class="db-muted"><%= fmt.dateTime(b.startTime) %> to <%= fmt.timeOnly(b.endTime) %> · Slot <%= b.slotLabel %> · <%= b.vehiclePlate %></span>
          </div>
          <div class="db-next__actions">
            <% if (z) { %><%- include('../includes/directionsButton', { zone: z, size: 'sm', label: 'Directions' }) %><% } %>
            <% if (b.status === 'pending_payment') { %><a class="btn btn-primary btn-sm rounded-pill px-3" href="/user/bookings/<%= b._id %>/pay"><i class="bi bi-credit-card" aria-hidden="true"></i> Pay now</a><% } %>
            <a class="btn btn-outline-secondary btn-sm rounded-pill px-3" href="/user/bookings/<%= b._id %>">Details</a>
          </div>
        </div>
      <% } else { %>
        <div class="db-map__booking">
          <div class="db-map__booking-main"><strong class="db-map__booking-title">No upcoming bookings</strong><span class="db-muted">Tap a pin to see free bays, then book in a minute.</span></div>
          <div class="db-next__actions"><a class="btn btn-primary btn-sm rounded-pill px-3" href="/user/search"><i class="bi bi-search" aria-hidden="true"></i> Find a spot</a></div>
        </div>
      <% } %>
    </div>

    <% if (nextBooking && laterBookings.length) { %>
      <h3 class="db-subtitle">Also coming up</h3>
      <ul class="db-list">
        <% laterBookings.forEach(function (lb) { %>
          <li class="db-list__item">
            <a class="db-list__main" href="/user/bookings/<%= lb._id %>">
              <strong><%= lb.zone ? lb.zone.name : 'Parking zone' %></strong>
              <span class="db-muted"><%= fmt.dateTime(lb.startTime) %> to <%= fmt.timeOnly(lb.endTime) %> · Slot <%= lb.slotLabel %></span>
            </a>
            <%- include('../includes/db-status-badge', { status: lb.status }) %>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </section>

  <%# 3. Stat tiles (real numbers only) %>
  <section class="db-section" aria-labelledby="db-stats-title">
    <h2 class="db-section__title" id="db-stats-title">Your parking in numbers</h2>
    <div class="db-tiles">
      <% stats.forEach(function (s) { %><%- include('../includes/db-stat-tile', s) %><% }) %>
    </div>
  </section>

  <%# 4. Parking you may like %>
  <section class="db-section" aria-labelledby="db-list-title" data-db-listing>
    <div class="db-head">
      <div>
        <h2 class="db-section__title mb-1" id="db-list-title">Parking you may like</h2>
        <p class="db-muted mb-0">Showing <%= listing.length %> of <%= activeZoneCount %> zone<%= activeZoneCount === 1 ? '' : 's' %> in SPACER</p>
      </div>
      <a class="db-link" href="/user/search">See all zones <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
    </div>

    <% if (!listing.length) { %>
      <div class="db-card">
        <%- include('../includes/db-empty', { illus: 'zone', title: 'No zones to show yet', text: 'Parking zones appear here as soon as owners list them. You can still open the full search.', href: '/user/search', cta: 'Open search', ctaIcon: 'bi-search' }) %>
      </div>
    <% } else { %>
      <div class="db-toolbar">
        <div class="db-toggle" role="group" aria-label="Choose list or grid layout">
          <button type="button" class="db-toggle__btn" data-db-view="list" aria-pressed="true" aria-label="List view"><i class="bi bi-list-ul" aria-hidden="true"></i></button>
          <button type="button" class="db-toggle__btn" data-db-view="grid" aria-pressed="false" aria-label="Grid view"><i class="bi bi-grid-3x3-gap" aria-hidden="true"></i></button>
        </div>
        <div class="db-pills" role="group" aria-label="Sort zones">
          <button type="button" class="db-pill" data-db-sort="price" aria-pressed="false">Lowest price</button>
          <button type="button" class="db-pill" data-db-sort="free" aria-pressed="false">Most free bays</button>
          <button type="button" class="db-pill" data-db-sort="near" aria-pressed="false"><i class="bi bi-crosshair" aria-hidden="true"></i> Nearest</button>
        </div>
      </div>
      <p class="db-note" data-db-note hidden></p>
      <p class="visually-hidden" role="status" aria-live="polite" data-db-live></p>

      <div class="db-zonelist" data-db-zonelist data-view="list">
        <% listing.forEach(function (c, i) { %><%- include('../includes/db-zone-card', { c: c, index: i }) %><% }) %>
      </div>
    <% } %>
  </section>

  <%# 5. Recent activity %>
  <section class="db-section" aria-labelledby="db-recent-title">
    <div class="db-head">
      <h2 class="db-section__title mb-0" id="db-recent-title">Recent activity</h2>
      <% if (recent.length) { %><a class="db-link" href="/user/bookings">All bookings <i class="bi bi-arrow-right" aria-hidden="true"></i></a><% } %>
    </div>
    <% if (!recent.length) { %>
      <div class="db-card">
        <%- include('../includes/db-empty', { illus: 'list', title: 'Nothing here yet', text: 'Your bookings and payments will appear here as a simple timeline.', href: '/user/search', cta: 'Find a spot', ctaIcon: 'bi-search' }) %>
      </div>
    <% } else { %>
      <div class="db-card">
        <ol class="db-timeline">
          <% recent.forEach(function (b) { %>
            <li class="db-timeline__item db-timeline__item--<%= fmt.statusClass(b.status) %>">
              <span class="db-timeline__dot" aria-hidden="true"><i class="bi <%= b.icon %>"></i></span>
              <a class="db-timeline__body" href="/user/bookings/<%= b._id %>">
                <span class="db-timeline__title"><%= b.zone ? b.zone.name : 'Parking zone' %></span>
                <span class="db-muted"><%= fmt.dateTime(b.startTime) %> · Slot <%= b.slotLabel %></span>
              </a>
              <span class="db-timeline__side">
                <strong class="db-timeline__amt"><%= fmt.currency(b.totalAmount) %></strong>
                <%- include('../includes/db-status-badge', { status: b.status }) %>
              </span>
            </li>
          <% }) %>
        </ol>
      </div>
    <% } %>
  </section>

  <%# 6. Closing call to action %>
  <section class="db-cta" aria-labelledby="db-cta-title">
    <div class="db-cta__text">
      <h2 class="db-cta__title" id="db-cta-title">Search more parking</h2>
      <p class="db-cta__sub">Type an area, a landmark or a zone name and see what is open near you.</p>
    </div>
    <form class="db-cta__form" action="/user/search" method="GET">
      <label class="db-cta__label" for="db-cta-q">Area or name</label>
      <div class="db-cta__field">
        <i class="bi bi-geo-alt" aria-hidden="true"></i>
        <input id="db-cta-q" name="q" type="search" placeholder="Hinjewadi, FC Road, Baner...">
        <button type="submit" aria-label="Search this area"><i class="bi bi-search" aria-hidden="true"></i></button>
      </div>
    </form>
  </section>

</div>
