# Copy this file to .env and fill in the values
PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/spacer
SESSION_SECRET=replace-with-a-long-random-string
NODE_ENV=development

# Set to true only when the site is served over HTTPS
COOKIE_SECURE=false

# Mock payment gateway: probability that a payment succeeds (0 to 1)
PAYMENT_SUCCESS_RATE=0.9

# Login/register attempts allowed per IP per 15 minutes
AUTH_RATE_LIMIT_MAX=10
