<% layout('/layouts/boilerplate') -%>
<h1 class="h3 mb-3">Find parking</h1>
<form action="/user/search" method="GET" class="card card-body mb-4">
  <div class="row g-2 align-items-end">
    <div class="col-md-4"><label class="form-label small" for="q">Area or name</label><input class="form-control" id="q" name="q" value="<%= query.q || '' %>" placeholder="Koregaon Park, FC Road..."></div>
    <div class="col-md-4"><label class="form-label small" for="start">From</label><input type="datetime-local" step="900" class="form-control" id="start" name="start" value="<%= query.start || '' %>"></div>
    <div class="col-md-4"><label class="form-label small" for="end">Until</label><input type="datetime-local" step="900" class="form-control" id="end" name="end" value="<%= query.end || '' %>"></div>
    <div class="col-md-3"><label class="form-label small" for="vehicleType">Vehicle</label>
      <select class="form-select" id="vehicleType" name="vehicleType"><option value="">Any</option>
        <% ['bike','car','suv','ev'].forEach(function (t) { %><option value="<%= t %>" <%= query.vehicleType === t ? 'selected' : '' %>><%= fmt.vehicleLabel(t) %></option><% }) %>
      </select></div>
    <div class="col-md-3"><label class="form-label small" for="maxPrice">Max base price (₹/h)</label><input type="number" min="0" class="form-control" id="maxPrice" name="maxPrice" value="<%= query.maxPrice !== undefined ? query.maxPrice : '' %>"></div>
    <div class="col-md-3"><button type="button" id="useLocation" class="btn btn-outline-primary w-100"><i class="bi bi-geo-alt"></i> Near me</button></div>
    <div class="col-md-3"><button type="submit" class="btn btn-primary w-100">Search</button></div>
  </div>
  <input type="hidden" id="lat" name="lat" value="<%= query.lat !== undefined ? query.lat : '' %>">
  <input type="hidden" id="lng" name="lng" value="<%= query.lng !== undefined ? query.lng : '' %>">
</form>

<% if (windowError) { %><div class="alert alert-warning"><%= windowError %> Showing zones without availability.</div><% } %>

<% if (!results.length) { %>
  <div class="text-center text-muted py-5">
    <i class="bi bi-search display-5"></i>
    <p class="mt-2">No parking zones match. Try a wider area, another vehicle type, or a higher price limit.</p>
  </div>
<% } else { %>
  <p class="text-muted small"><%= results.length %> zone<%= results.length > 1 ? 's' : '' %> found<%= useWindow ? ' with live availability for your time' : '' %>.</p>
  <div class="row g-3">
    <% results.forEach(function (info) { %>
      <div class="col-md-6 col-lg-4"><%- include('../includes/zoneCard', { info: info, detailQuery: detailQuery }) %></div>
    <% }) %>
  </div>
<% } %>
