<% layout('/layouts/boilerplate') -%>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">My zones</h1>
  <a href="/owner/zones/new" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg"></i> Add zone</a>
</div>
<% if (!zones.length) { %>
  <div class="text-center text-muted py-5"><i class="bi bi-p-square display-5"></i><p class="mt-2">No zones yet. <a href="/owner/zones/new">Add your first one</a> and start earning from unused space.</p></div>
<% } else { %>
  <div class="row g-3">
    <% zones.forEach(function (z) { %>
      <div class="col-md-6 col-lg-4"><div class="card h-100">
        <% if (z.images && z.images[0]) { %><img src="<%= z.images[0] %>" class="sp-zone-img" alt="<%= z.name %>" loading="lazy"><% } else { %><div class="sp-zone-img sp-zone-img--empty" aria-hidden="true"><i class="bi bi-p-square-fill"></i></div><% } %>
        <div class="card-body d-flex flex-column">
          <div class="d-flex justify-content-between"><h5 class="mb-1"><%= z.name %></h5><% if (!z.isActive) { %><span class="badge text-bg-secondary">Hidden</span><% } %></div>
          <p class="small text-muted mb-2"><%= z.address %></p>
          <p class="small mb-3"><%= slotCount[z._id] || 0 %> slots · <%= fmt.currency(z.basePricePerHour) %>/h base · <%= z.openTime %> to <%= z.closeTime %></p>
          <a href="/owner/zones/<%= z._id %>" class="btn btn-outline-primary btn-sm mt-auto">Manage</a>
        </div>
      </div></div>
    <% }) %>
  </div>
<% } %>
