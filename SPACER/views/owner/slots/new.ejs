<% layout('/layouts/boilerplate') -%>
<div class="row justify-content-center"><div class="col-lg-6">
  <a href="/owner/zones/<%= zone._id %>" class="small text-decoration-none">&larr; <%= zone.name %></a>
  <h1 class="h3 mt-1 mb-3">Add slots</h1>
  <div class="card"><div class="card-body p-4">
    <form action="/owner/zones/<%= zone._id %>/slots" method="POST" class="needs-validation" novalidate>
      <div class="row">
        <div class="col-6 mb-3"><label class="form-label" for="prefix">Label prefix</label><input class="form-control text-uppercase" id="prefix" name="slot[prefix]" value="A" maxlength="6" pattern="[A-Za-z0-9]{1,6}" required><div class="form-text">"A" creates A-01, A-02...</div></div>
        <div class="col-6 mb-3"><label class="form-label" for="count">How many?</label><input type="number" class="form-control" id="count" name="slot[count]" min="1" max="50" value="5" required><div class="form-text">1 to 50 at once.</div></div>
      </div>
      <div class="mb-3"><label class="form-label" for="vehicleType">Vehicle type</label>
        <select class="form-select" id="vehicleType" name="slot[vehicleType]">
          <% zone.vehicleTypesAllowed.forEach(function (t) { %><option value="<%= t %>"><%= fmt.vehicleLabel(t) %></option><% }) %>
        </select></div>
      <div class="form-check mb-3"><input class="form-check-input" type="checkbox" id="hasEVCharger" name="slot[hasEVCharger]"><label class="form-check-label" for="hasEVCharger">These slots have an EV charger (always on for EV slots)</label></div>
      <button class="btn btn-primary" type="submit" data-loading-text="Adding...">Add slots</button>
      <a class="btn btn-outline-secondary" href="/owner/zones/<%= zone._id %>">Cancel</a>
    </form>
  </div></div>
</div></div>
