<% layout('/layouts/boilerplate') -%>
<div class="text-center py-5">
  <div class="display-1 sp-display text-primary"><%= status %></div>
  <h2 class="mb-2"><%= status >= 500 ? 'Something went wrong' : status === 403 ? 'You cannot open this page' : 'That did not work' %></h2>
  <p class="text-muted mx-auto" style="max-width: 36rem"><%= message %></p>
  <button type="button" class="btn btn-primary" data-back>Go back</button>
  <a href="/" class="btn btn-outline-secondary">Home</a>
  <% if (stack) { %>
    <pre class="text-start small bg-white border rounded p-3 mt-4 overflow-auto"><%= stack %></pre>
  <% } %>
</div>
